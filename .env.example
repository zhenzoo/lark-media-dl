# Optional local configuration. Copy to .env, never commit real values.
# Default: files saved to the current user's Downloads; no cloud upload.
# MEDIA_DL_OUTPUT_DIR=/path/to/Downloads
# Media proxy for YouTube, X and LinkedIn pages/CDNs when they are not reachable directly.
# MEDIA_DL_PROXY=http://127.0.0.1:YOUR_ACTUAL_PORT
# FFMPEG_BINARY=/path/to/ffmpeg
# MEDIA_DL_JS_RUNTIME=node

# Threads requires this; Xiaohongshu can also use it. Register at https://tikhub.io/
# TIKHUB_API_KEY=
# Mainland API endpoint; use https://api.tikhub.io elsewhere.
# TIKHUB_BASE=https://api.tikhub.dev

# Optional Netscape-format cookie files for content your account can access.
# MEDIA_DL_BILIBILI_COOKIES=/path/to/cookies.txt
# MEDIA_DL_YOUTUBE_COOKIES=/path/to/cookies.txt
# MEDIA_DL_XIAOHONGSHU_COOKIES=/path/to/cookies.txt

# Optional GUI Worker only. Create your own Miaoda app and Worker key.
# MEDIA_WORKER_API_BASE=https://your-app.example.com
# MEDIA_WORKER_API_KEY=
# MEDIA_WORKER_ID=my-computer
MEDIA_DELIVERY=local

# Optional phone retrieval only: pip install '.[oss]' and set MEDIA_DELIVERY=oss
# OSS_BUCKET=
# OSS_ENDPOINT=https://oss-your-region.aliyuncs.com
# OSS_REGION=cn-your-region
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_URL_DAYS=1
